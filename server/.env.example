# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# In production set this to the URL that serves the frontend.
CORS_ORIGIN=http://localhost:5173

# Set when running behind a reverse proxy so rate limiting sees the real client
# IP (e.g. 1 = trust exactly one proxy hop). Leave empty when not proxied.
TRUST_PROXY=

# ── Accounts & roles ────────────────────────────────────────────────────────
# SQLite file holding accounts, sessions and usage counts (never conversation content)
DB_PATH=./data/chatpdf.db
# First admin, created on start-up if no admin exists yet (or use: npm run user:create -- --role admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Anyone may create a "user" account. Set to false so only admins can create accounts.
ALLOW_SIGNUP=true
# How long a login lasts
SESSION_TTL_DAYS=7
# Login / sign-up attempts per IP per 15 minutes
RATE_LIMIT_LOGINS=10

# ── Abuse protection ────────────────────────────────────────────────────────
# Conversions (extract + convert) allowed per client IP per window
RATE_LIMIT_CONVERSIONS=20
RATE_LIMIT_WINDOW_MS=900000
# URL validation calls (debounced typing in the UI) per client IP per minute
RATE_LIMIT_VALIDATIONS=120
# Hard limit for one conversion request (ms)
REQUEST_TIMEOUT_MS=180000

# ── Headless browser ────────────────────────────────────────────────────────
# Chromium instances that may run at once, and how many requests may wait
BROWSER_MAX_CONCURRENCY=2
BROWSER_MAX_QUEUE=8
BROWSER_QUEUE_WAIT_MS=60000
BROWSER_JOB_TIMEOUT_MS=90000
PDF_RENDER_TIMEOUT_MS=90000
# Optional: use a system Chromium instead of Playwright's bundled one
PLAYWRIGHT_CHROMIUM_PATH=
# Enable the Chromium OS sandbox (recommended where supported; Playwright default is off)
PLAYWRIGHT_CHROMIUM_SANDBOX=true

# ── Direct HTTP retrieval ───────────────────────────────────────────────────
FETCH_TIMEOUT_MS=15000
# Maximum upstream response size in bytes (large shared conversations reach a few MB)
FETCH_MAX_BYTES=26214400
